# This file is for the Mac (dev, tests, scripts/). The NAS doesn't use it: its settings and the
# Tailscale auth key go in the Container Manager project's YAML (deploy/compose.yaml, docs/deploy.md).

# iKamand on the LAN (reserved in eero)
IKAMAND_HOST=10.0.4.98
TZ=America/New_York

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Server (EMBER_PORT, not PORT — dev tooling overrides PORT)
EMBER_PORT=8080
DATA_DIR=./data
# Use the simulator instead of the real device (dev/test). The server then runs it in-process with
# SIM_SCENARIO and SIM_SPEED, and keeps its own DB (DATA_DIR/ember-sim.db)
USE_SIMULATOR=true
# Simulator scenario and speed-up factor (server and npm run sim); SIM_PORT is npm run sim only
SIM_SCENARIO=brisket
SIM_SPEED=1
SIM_PORT=8081
