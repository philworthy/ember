# iKamand on the LAN (reserved in eero)
IKAMAND_HOST=10.0.4.98
TZ=America/New_York

# Tailscale sidecar (generate a reusable auth key in the Tailscale admin console > Settings > Keys)
TS_AUTHKEY=
TS_HOSTNAME=ember

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Server
PORT=8080
DATA_DIR=./data
# Use the simulator instead of the real device (dev/test)
USE_SIMULATOR=true
